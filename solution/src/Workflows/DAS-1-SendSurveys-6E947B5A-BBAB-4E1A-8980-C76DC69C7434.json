{
  "properties": {
    "connectionReferences": {
      "shared_excelonlinebusiness": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "das_ExcelOnlineBusiness"
        },
        "api": {
          "name": "shared_excelonlinebusiness"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "das_Office365Outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Inventory Source (das_InventorySource)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventorySource"
          }
        },
        "Inventory Drive (das_InventoryDrive)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventoryDrive"
          }
        },
        "Inventory File (das_InventoryFile)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventoryFile"
          }
        },
        "Inventory Table (das_InventoryTable)": {
          "defaultValue": "Inventory",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventoryTable"
          }
        },
        "Sender Mailbox (das_SenderMailbox)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_SenderMailbox"
          }
        },
        "Admin Email (das_AdminEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_AdminEmail"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "CampaignID",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "CampaignID to send. Use * to send every Pending row.",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Initialize_SentCount": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "SentCount",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {}
        },
        "Initialize_Errors": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Errors",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {
            "Initialize_SentCount": [
              "Succeeded"
            ]
          }
        },
        "Compose_CampaignID": {
          "type": "Compose",
          "inputs": "@trim(coalesce(triggerBody()?['text'], '*'))",
          "runAfter": {
            "Initialize_Errors": [
              "Succeeded"
            ]
          }
        },
        "List_inventory_rows": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_excelonlinebusiness",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
            },
            "parameters": {
              "source": "@parameters('Inventory Source (das_InventorySource)')",
              "drive": "@parameters('Inventory Drive (das_InventoryDrive)')",
              "file": "@parameters('Inventory File (das_InventoryFile)')",
              "table": "@parameters('Inventory Table (das_InventoryTable)')",
              "dateTimeFormat": "ISO 8601"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          },
          "runAfter": {
            "Compose_CampaignID": [
              "Succeeded"
            ]
          }
        },
        "Filter_pending_rows": {
          "type": "Query",
          "inputs": {
            "from": "@outputs('List_inventory_rows')?['body/value']",
            "where": "@and(equals(trim(string(item()?['Status'])), 'Pending'), or(equals(outputs('Compose_CampaignID'), '*'), equals(trim(string(item()?['CampaignID'])), outputs('Compose_CampaignID'))))"
          },
          "runAfter": {
            "List_inventory_rows": [
              "Succeeded"
            ]
          }
        },
        "For_each_row": {
          "type": "Foreach",
          "foreach": "@body('Filter_pending_rows')",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "actions": {
            "Check_required_fields": {
              "type": "If",
              "expression": {
                "equals": [
                  "@or(empty(trim(string(items('For_each_row')?['OwnerEmail']))), empty(trim(string(items('For_each_row')?['FormsUrl']))))",
                  true
                ]
              },
              "actions": {
                "Update_row_missing_fields": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_excelonlinebusiness",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
                    },
                    "parameters": {
                      "source": "@parameters('Inventory Source (das_InventorySource)')",
                      "drive": "@parameters('Inventory Drive (das_InventoryDrive)')",
                      "file": "@parameters('Inventory File (das_InventoryFile)')",
                      "table": "@parameters('Inventory Table (das_InventoryTable)')",
                      "idColumn": "AppID",
                      "id": "@items('For_each_row')?['AppID']",
                      "item/Status": "Error",
                      "item/LastError": "@{utcNow('yyyy-MM-ddTHH:mm:ssZ')} Send: OwnerEmail or FormsUrl is blank"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                },
                "Append_missing_fields_error": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Errors",
                    "value": {
                      "AppID": "@items('For_each_row')?['AppID']",
                      "ApplicationName": "@items('For_each_row')?['ApplicationName']",
                      "Error": "OwnerEmail or FormsUrl is blank"
                    }
                  },
                  "runAfter": {
                    "Update_row_missing_fields": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Try": {
                    "type": "Scope",
                    "actions": {
                      "Send_survey_email": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_office365",
                            "operationId": "SharedMailboxSendEmailV2",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                          },
                          "parameters": {
                            "emailMessage/MailboxAddress": "@parameters('Sender Mailbox (das_SenderMailbox)')",
                            "emailMessage/To": "@{trim(string(items('For_each_row')?['OwnerEmail']))}",
                            "emailMessage/Subject": "Action required: application owner survey for @{items('For_each_row')?['ApplicationName']}",
                            "emailMessage/Body": "<p>Hello @{items('For_each_row')?['OwnerName']},</p>\n<p>You are recorded as the business owner of the application below. As part of our digital asset review, please complete a short survey confirming ownership and key details for this application.</p>\n<table cellpadding=\"4\" style=\"border-collapse:collapse\">\n<tr><td><b>Application</b></td><td>@{items('For_each_row')?['ApplicationName']}</td></tr>\n<tr><td><b>App ID</b></td><td>@{items('For_each_row')?['AppID']}</td></tr>\n<tr><td><b>Catalogue ID</b></td><td>@{items('For_each_row')?['AppCatID']}</td></tr>\n<tr><td><b>Business criticality</b></td><td>@{items('For_each_row')?['Criticality']}</td></tr>\n</table>\n<p><a href=\"@{items('For_each_row')?['FormsUrl']}\">Open the survey</a></p>\n<p>If you are not the right owner for this application, please say so in the survey and name the correct owner.</p>\n<p>Thank you.</p>",
                            "emailMessage/Importance": "Normal"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {}
                      },
                      "Update_row_sent": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_excelonlinebusiness",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
                          },
                          "parameters": {
                            "source": "@parameters('Inventory Source (das_InventorySource)')",
                            "drive": "@parameters('Inventory Drive (das_InventoryDrive)')",
                            "file": "@parameters('Inventory File (das_InventoryFile)')",
                            "table": "@parameters('Inventory Table (das_InventoryTable)')",
                            "idColumn": "AppID",
                            "id": "@items('For_each_row')?['AppID']",
                            "item/Status": "Sent",
                            "item/SentDate": "@utcNow('yyyy-MM-ddTHH:mm:ssZ')",
                            "item/LastReminder": "",
                            "item/ReminderCount": "0",
                            "item/LastError": ""
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {
                          "Send_survey_email": [
                            "Succeeded"
                          ]
                        }
                      },
                      "Increment_SentCount": {
                        "type": "IncrementVariable",
                        "inputs": {
                          "name": "SentCount",
                          "value": 1
                        },
                        "runAfter": {
                          "Update_row_sent": [
                            "Succeeded"
                          ]
                        }
                      }
                    },
                    "runAfter": {}
                  },
                  "Catch": {
                    "type": "Scope",
                    "actions": {
                      "Filter_failed_actions": {
                        "type": "Query",
                        "inputs": {
                          "from": "@result('Try')",
                          "where": "@equals(item()?['status'], 'Failed')"
                        },
                        "runAfter": {}
                      },
                      "Compose_error": {
                        "type": "Compose",
                        "inputs": "@take(concat(utcNow('yyyy-MM-ddTHH:mm:ssZ'), ' Send: ', coalesce(first(body('Filter_failed_actions'))?['name'], 'unknown action'), ': ', coalesce(first(body('Filter_failed_actions'))?['error']?['message'], first(body('Filter_failed_actions'))?['outputs']?['body']?['message'], first(body('Filter_failed_actions'))?['outputs']?['body']?['error']?['message'], 'timed out or unknown error')), 500)",
                        "runAfter": {
                          "Filter_failed_actions": [
                            "Succeeded"
                          ]
                        }
                      },
                      "Update_row_error": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_excelonlinebusiness",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
                          },
                          "parameters": {
                            "source": "@parameters('Inventory Source (das_InventorySource)')",
                            "drive": "@parameters('Inventory Drive (das_InventoryDrive)')",
                            "file": "@parameters('Inventory File (das_InventoryFile)')",
                            "table": "@parameters('Inventory Table (das_InventoryTable)')",
                            "idColumn": "AppID",
                            "id": "@items('For_each_row')?['AppID']",
                            "item/Status": "Error",
                            "item/LastError": "@outputs('Compose_error')"
                          },
                          "authentication": "@parameters('$authentication')"
                        },
                        "runAfter": {
                          "Compose_error": [
                            "Succeeded"
                          ]
                        }
                      },
                      "Append_send_error": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "Errors",
                          "value": {
                            "AppID": "@items('For_each_row')?['AppID']",
                            "ApplicationName": "@items('For_each_row')?['ApplicationName']",
                            "Error": "@outputs('Compose_error')"
                          }
                        },
                        "runAfter": {
                          "Update_row_error": [
                            "Succeeded",
                            "Failed"
                          ]
                        }
                      }
                    },
                    "runAfter": {
                      "Try": [
                        "Failed",
                        "TimedOut"
                      ]
                    }
                  }
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Filter_pending_rows": [
              "Succeeded"
            ]
          }
        },
        "Create_error_table": {
          "type": "Table",
          "inputs": {
            "from": "@variables('Errors')",
            "format": "HTML"
          },
          "runAfter": {
            "For_each_row": [
              "Succeeded",
              "Failed"
            ]
          }
        },
        "Send_summary_to_admin": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('Sender Mailbox (das_SenderMailbox)')",
              "emailMessage/To": "@parameters('Admin Email (das_AdminEmail)')",
              "emailMessage/Subject": "Digital asset survey send (campaign @{outputs('Compose_CampaignID')}): @{variables('SentCount')} sent, @{length(variables('Errors'))} errors",
              "emailMessage/Body": "<p>Campaign: @{outputs('Compose_CampaignID')}</p>\n<p>Pending rows matched: @{length(body('Filter_pending_rows'))}<br>Surveys sent: @{variables('SentCount')}<br>Errors: @{length(variables('Errors'))}</p>\n@{if(empty(variables('Errors')), '<p>No errors.</p>', concat('<p>Rows set to Status = Error (fix the row, set Status back to Pending, and re-run):</p>', body('Create_error_table')))}",
              "emailMessage/Importance": "@{if(empty(variables('Errors')), 'Normal', 'High')}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Create_error_table": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
