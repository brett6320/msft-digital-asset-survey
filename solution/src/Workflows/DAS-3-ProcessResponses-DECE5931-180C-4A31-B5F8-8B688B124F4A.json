{
  "properties": {
    "connectionReferences": {
      "shared_excelonlinebusiness": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "das_ExcelOnlineBusiness"
        },
        "api": {
          "name": "shared_excelonlinebusiness"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "das_Office365Outlook"
        },
        "api": {
          "name": "shared_office365"
        }
      },
      "shared_microsoftforms": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "das_MicrosoftForms"
        },
        "api": {
          "name": "shared_microsoftforms"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Inventory Source (das_InventorySource)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventorySource"
          }
        },
        "Inventory Drive (das_InventoryDrive)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventoryDrive"
          }
        },
        "Inventory File (das_InventoryFile)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventoryFile"
          }
        },
        "Inventory Table (das_InventoryTable)": {
          "defaultValue": "Inventory",
          "type": "String",
          "metadata": {
            "schemaName": "das_InventoryTable"
          }
        },
        "Sender Mailbox (das_SenderMailbox)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_SenderMailbox"
          }
        },
        "Admin Email (das_AdminEmail)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_AdminEmail"
          }
        },
        "Form Id (das_FormId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_FormId"
          }
        },
        "Form AppID Question Id (das_FormAppIdQuestionId)": {
          "defaultValue": "",
          "type": "String",
          "metadata": {
            "schemaName": "das_FormAppIdQuestionId"
          }
        }
      },
      "triggers": {
        "When_a_new_response_is_submitted": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_microsoftforms",
              "operationId": "CreateFormWebhook",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms"
            },
            "parameters": {
              "form_id": "@parameters('Form Id (das_FormId)')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "splitOn": "@triggerOutputs()?['body/value']"
        }
      },
      "actions": {
        "Get_response_details": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_microsoftforms",
              "operationId": "GetFormResponseById",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftforms"
            },
            "parameters": {
              "form_id": "@parameters('Form Id (das_FormId)')",
              "response_id": "@triggerOutputs()?['body/resourceData/responseId']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {}
        },
        "Compose_response": {
          "type": "Compose",
          "inputs": {
            "ResponseID": "@{triggerOutputs()?['body/resourceData/responseId']}",
            "Responder": "@{trim(string(body('Get_response_details')?['responder']))}",
            "AppID": "@{trim(string(body('Get_response_details')?[parameters('Form AppID Question Id (das_FormAppIdQuestionId)')]))}"
          },
          "runAfter": {
            "Get_response_details": [
              "Succeeded"
            ]
          }
        },
        "Check_AppID_present": {
          "type": "If",
          "expression": {
            "equals": [
              "@empty(outputs('Compose_response')?['AppID'])",
              true
            ]
          },
          "actions": {
            "Notify_admin_missing_AppID": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('Sender Mailbox (das_SenderMailbox)')",
                  "emailMessage/To": "@parameters('Admin Email (das_AdminEmail)')",
                  "emailMessage/Subject": "Digital asset survey: response @{outputs('Compose_response')?['ResponseID']} has no AppID",
                  "emailMessage/Body": "<p>A survey response was submitted without an AppID, so it could not be matched to the inventory.</p>\n<p>Response ID: @{outputs('Compose_response')?['ResponseID']}<br>Responder: @{outputs('Compose_response')?['Responder']}</p>\n<p>Find the response in Forms, identify the application, and update the inventory row by hand (Status = Completed, ResponseID, ResponseEmail, CompletedDate). If this keeps happening, check that FormsUrl is a pre-filled link that sets the AppID question.</p>",
                  "emailMessage/Importance": "High"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Terminate_missing_AppID": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "MissingAppID",
                  "message": "Response @{outputs('Compose_response')?['ResponseID']} has no AppID"
                }
              },
              "runAfter": {
                "Notify_admin_missing_AppID": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Compose_response": [
              "Succeeded"
            ]
          }
        },
        "Get_inventory_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_excelonlinebusiness",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
            },
            "parameters": {
              "source": "@parameters('Inventory Source (das_InventorySource)')",
              "drive": "@parameters('Inventory Drive (das_InventoryDrive)')",
              "file": "@parameters('Inventory File (das_InventoryFile)')",
              "table": "@parameters('Inventory Table (das_InventoryTable)')",
              "idColumn": "AppID",
              "id": "@outputs('Compose_response')?['AppID']",
              "dateTimeFormat": "ISO 8601"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Check_AppID_present": [
              "Succeeded"
            ]
          }
        },
        "Handle_unknown_AppID": {
          "type": "Scope",
          "actions": {
            "Notify_admin_unknown_AppID": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('Sender Mailbox (das_SenderMailbox)')",
                  "emailMessage/To": "@parameters('Admin Email (das_AdminEmail)')",
                  "emailMessage/Subject": "Digital asset survey: response for unknown AppID @{outputs('Compose_response')?['AppID']}",
                  "emailMessage/Body": "<p>A survey response could not be matched to an inventory row.</p>\n<p>AppID on response: @{outputs('Compose_response')?['AppID']}<br>Response ID: @{outputs('Compose_response')?['ResponseID']}<br>Responder: @{outputs('Compose_response')?['Responder']}</p>\n<p>Lookup error: @{coalesce(outputs('Get_inventory_row')?['body']?['message'], outputs('Get_inventory_row')?['body']?['error']?['message'], 'see run history')}</p>\n<p>The AppID may have been edited by the respondent, or the row may have been removed or renamed. Update the inventory by hand.</p>",
                  "emailMessage/Importance": "High"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Terminate_unknown_AppID": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "UnknownAppID",
                  "message": "No inventory row for AppID @{outputs('Compose_response')?['AppID']}"
                }
              },
              "runAfter": {
                "Notify_admin_unknown_AppID": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          },
          "runAfter": {
            "Get_inventory_row": [
              "Failed",
              "TimedOut"
            ]
          }
        },
        "Compose_note": {
          "type": "Compose",
          "inputs": "@{if(equals(toLower(outputs('Compose_response')?['Responder']), toLower(trim(string(body('Get_inventory_row')?['OwnerEmail'])))), '', concat(utcNow('yyyy-MM-ddTHH:mm:ssZ'), ' Response: responder ', outputs('Compose_response')?['Responder'], ' is not OwnerEmail. '))}@{if(equals(body('Get_inventory_row')?['Status'], 'Completed'), concat(utcNow('yyyy-MM-ddTHH:mm:ssZ'), ' Response: duplicate; superseded ResponseID ', string(body('Get_inventory_row')?['ResponseID']), '.'), '')}",
          "runAfter": {
            "Get_inventory_row": [
              "Succeeded"
            ]
          }
        },
        "Update_row_completed": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_excelonlinebusiness",
              "operationId": "PatchItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_excelonlinebusiness"
            },
            "parameters": {
              "source": "@parameters('Inventory Source (das_InventorySource)')",
              "drive": "@parameters('Inventory Drive (das_InventoryDrive)')",
              "file": "@parameters('Inventory File (das_InventoryFile)')",
              "table": "@parameters('Inventory Table (das_InventoryTable)')",
              "idColumn": "AppID",
              "id": "@outputs('Compose_response')?['AppID']",
              "item/Status": "Completed",
              "item/ResponseID": "@outputs('Compose_response')?['ResponseID']",
              "item/ResponseEmail": "@outputs('Compose_response')?['Responder']",
              "item/CompletedDate": "@utcNow('yyyy-MM-ddTHH:mm:ssZ')",
              "item/LastError": "@outputs('Compose_note')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Compose_note": [
              "Succeeded"
            ]
          }
        },
        "Handle_update_failure": {
          "type": "Scope",
          "actions": {
            "Notify_admin_update_failed": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('Sender Mailbox (das_SenderMailbox)')",
                  "emailMessage/To": "@parameters('Admin Email (das_AdminEmail)')",
                  "emailMessage/Subject": "Digital asset survey: could not record response for AppID @{outputs('Compose_response')?['AppID']}",
                  "emailMessage/Body": "<p>A survey response was received but the inventory row could not be updated.</p>\n<p>AppID: @{outputs('Compose_response')?['AppID']}<br>Response ID: @{outputs('Compose_response')?['ResponseID']}<br>Responder: @{outputs('Compose_response')?['Responder']}</p>\n<p>Error: @{coalesce(outputs('Update_row_completed')?['body']?['message'], outputs('Update_row_completed')?['body']?['error']?['message'], 'see run history')}</p>\n<p>Resubmit this flow run from run history once the cause is fixed (for example, the workbook was locked for editing), or update the row by hand.</p>",
                  "emailMessage/Importance": "High"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Terminate_update_failed": {
              "type": "Terminate",
              "inputs": {
                "runStatus": "Failed",
                "runError": {
                  "code": "UpdateFailed",
                  "message": "Could not update inventory row for AppID @{outputs('Compose_response')?['AppID']}"
                }
              },
              "runAfter": {
                "Notify_admin_update_failed": [
                  "Succeeded",
                  "Failed"
                ]
              }
            }
          },
          "runAfter": {
            "Update_row_completed": [
              "Failed",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
